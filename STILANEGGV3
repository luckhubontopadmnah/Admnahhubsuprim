local AntGuardTab = Window:Tab({Title = "Ant Guard 🛡️", Icon = "shield"})

AntGuardTab:Section({Title = "Sistema de Disparo & Teleporte Rápido"})

AntGuardTab:Toggle({
    Title = "🛡️ Ativar Ant Guard (ProximityPrompt Instantâneo)",
    Default = false,
    Callback = function(v)
        Config.AntGuard = v
        pcall(function()
            if v then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local originalCFrame = hrp.CFrame
                    if Config.UINotifications then
                        WindUI:Notify({Title = "Ant Guard Ativado! 🛡️", Content = "Varredura rápida de ProximityPrompts ligada.", Duration = 3, Icon = "shield"})
                    end
                    
                    task.spawn(function()
                        while Config.AntGuard do
                            local executedAny = false
                            for _, prompt in ipairs(Workspace:GetDescendants()) do
                                if not Config.AntGuard then break end
                                if prompt:IsA("ProximityPrompt") and not processedAntGuardPrompts[prompt] then
                                    local parent = prompt.Parent
                                    local targetPart = nil
                                    if parent then
                                        if parent:IsA("BasePart") then
                                            targetPart = parent
                                        elseif parent:IsA("Model") then
                                            targetPart = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
                                        end
                                    end
                                    
                                    if targetPart and hrp then
                                        processedAntGuardPrompts[prompt] = true
                                        local targetCF = targetPart:IsA("BasePart") and targetPart.CFrame or parent:GetPivot()
                                        
                                        -- Teleporte ultra-rápido para o prompt
                                        hrp.CFrame = targetCF + Vector3.new(0, 3, 0)
                                        task.wait(0.01)
                                        
                                        -- Disparar ação instantânea
                                        pcall(function()
                                            local oldDur = prompt.HoldDuration
                                            prompt.HoldDuration = 0
                                            if fireproximityprompt then
                                                fireproximityprompt(prompt)
                                            else
                                                prompt:InputHoldBegin()
                                                task.wait(0.01)
                                                prompt:InputHoldEnd()
                                            end
                                            prompt.HoldDuration = oldDur
                                        end)
                                        
                                        task.wait(0.03)
                                        -- Retornar à posição original de onde ativou
                                        hrp.CFrame = originalCFrame
                                        task.wait(0.05)
                                        executedAny = true
                                    end
                                end
                            end
                            if not executedAny then
                                task.wait(0.3)
                            end
                        end
                    end)
                end
            else
                processedAntGuardPrompts = {}
                if Config.UINotifications then
                    WindUI:Notify({Title = "Ant Guard Desativado! ⚙️", Content = "Sistema encerrado.", Duration = 3, Icon = "x"})
                end
            end
        end)
    end
})

