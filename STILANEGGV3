                            local returnTarget = safeZoneCFrame.Position
                            local returnDist = (returnTarget - returnStart).Magnitude
                            local returnTime = math.max(returnDist / speed, 0.05)
                            local retStartTime = tick()
                            while tick() - retStartTime < returnTime and Config.AutoFlight do
                                local alpha = (tick() - retStartTime) / returnTime
                                hrp.CFrame = CFrame.new(returnStart:Lerp(returnTarget, alpha))
                                task.wait()
                            end
                            
                            if Config.AutoFlight then
                                hrp.CFrame = safeZoneCFrame
                            end
                            task.wait(0.2)
                        else
                            task.wait(0.5)
                        end
                    end
                end)
            end
        end)
    end
})

