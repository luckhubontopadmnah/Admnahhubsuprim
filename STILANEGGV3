                if hrp and not safeZoneCFrame then
                    safeZoneCFrame = hrp.CFrame
                    createSafeZoneMarker(safeZoneCFrame)
                    if Config.UINotifications then
                        WindUI:Notify({Title = "Zona Segura Definida! 🛡️", Content = "Marcador de voo automático ativo.", Duration = 3, Icon = "shield"})
                    end
                end
            else
                if safeZoneMarker and not Config.InstantSteal then safeZoneMarker:Destroy() end
            end
        end)
        
        task.spawn(function()
            while Config.AutoFlight do
                task.wait(0.1)
                pcall(function()
                    if not Config.AutoFlight then return end
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    
                    if hrp and safeZoneCFrame then
                        local bestPrompt, bestTargetCFrame = getBestEggTarget()
                        
                        if bestPrompt and bestTargetCFrame and Config.AutoFlight then
                            local startPos = hrp.Position
                            local targetPos = bestTargetCFrame.Position
                            local distance = (targetPos - startPos).Magnitude
                            local speed = Config.FlightSpeed or 800
                            local travelTime = math.max(distance / speed, 0.05)
                            
                            local startTime = tick()
                            while tick() - startTime < travelTime and Config.AutoFlight do
                                local alpha = (tick() - startTime) / travelTime
                                hrp.CFrame = CFrame.new(startPos:Lerp(targetPos + Vector3.new(0, 3, 0), alpha))
                                task.wait()
                            end
                            
                            if not Config.AutoFlight then return end
                            hrp.CFrame = bestTargetCFrame + Vector3.new(0, 3, 0)
                            task.wait(0.08)
                            
                            secureGrabEgg(bestPrompt)
                            task.wait(0.35)
                            
                            local returnStart = hrp.Position
                            local returnTarget = safeZoneCFrame.Position
                            local returnDist = (returnTarget - returnStart).Magnitude
                            local returnTime = math.max(returnDist / speed, 0.05)
                            local retStartTime = tick()
                            while tick() - retStartTime < returnTime and Config.AutoFlight do
                                local alpha = (tick() - retStartTime) / returnTime
                                hrp.CFrame = CFrame.new(returnStart:Lerp(returnTarget, alpha))
                                task.wait()
                            end
                            
                            if Config.AutoFlight then
                                hrp.CFrame = safeZoneCFrame
                            end
                            task.wait(0.2)
                        else
                            task.wait(0.5)
                        end
                    end
                end)
            end
        end)
