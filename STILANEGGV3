                            local startPos = hrp.Position
                            local targetPos = bestTargetCFrame.Position
                            local distance = (targetPos - startPos).Magnitude
                            local speed = Config.FlightSpeed or 800
                            local travelTime = math.max(distance / speed, 0.05)
                            
                            -- Voo até o ovo escolhido
                            local startTime = tick()
                            while tick() - startTime < travelTime and Config.AutoFlight do
                                local alpha = (tick() - startTime) / travelTime
                                hrp.CFrame = CFrame.new(startPos:Lerp(targetPos + Vector3.new(0, 3, 0), alpha))
                                task.wait()
