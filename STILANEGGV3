-- Criador do Marcador Flutuante na Zona Segura
local function createSafeZoneMarker(cf)
    pcall(function()
        if safeZoneMarker then safeZoneMarker:Destroy() end
        
        local part = Instance.new("Part")
        part.Name = "SafeZoneTextMarker"
        part.Size = Vector3.new(4, 0.1, 4)
        part.CFrame = cf - Vector3.new(0, 2.5, 0)
        part.Anchored = true
        part.CanCollide = false
        part.Transparency = 1
        part.Parent = Workspace
        safeZoneMarker = part
        
        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 220, 0, 60)
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = part
        
        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "use teleport this"
        textLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Parent = billboard
    end)
end

-- Função de Seleção com Pontuação Extrema
local function getBestEggTarget()
    local bestPrompt = nil
    local bestTargetCFrame = nil
    local highestScore = -math.huge
    
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local parent = prompt.Parent
            if parent then
                local nameLower = (parent.Name .. " " .. prompt.Name):lower()
                
                if nameLower:find("egg") or nameLower:find("ovo") then
                    local targetPart = nil
                    local itemSize = Vector3.new(1,1,1)
                    
                    if parent:IsA("BasePart") then
                        targetPart = parent
                        itemSize = parent.Size
                    elseif parent:IsA("Model") then
                        targetPart = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
                        itemSize = parent:GetExtentsSize()
                    end
                    
                    if targetPart then
                        local rarityWeight = 1
                        for kw, weight in pairs(RarityWeights) do
                            if nameLower:find(kw) then
                                rarityWeight = weight
                                break
                            end
                        end
                        
                        local volume = itemSize.X * itemSize.Y * itemSize.Z
                        local score = 0
                        
                        if Config.EggPriority == "Mais Raro" then
                            score = (rarityWeight * 10000000) + (volume * 10)
                        elseif Config.EggPriority == "Mais Grande" then
                            score = (volume * 10000000) + (rarityWeight * 1000)
                        elseif Config.EggPriority == "Mais Caro" then
                            score = (rarityWeight * 7000000) + (volume * 500000)
                        else
                            score = (rarityWeight * 5000000) + volume
                        end
                        
                        if score > highestScore then
                            highestScore = score
                            bestPrompt = prompt
                            bestTargetCFrame = targetPart:IsA("BasePart") and targetPart.CFrame or parent:GetPivot()
                        end
                    end
                end
            end
        end
    end
    
    return bestPrompt, bestTargetCFrame
end

-- Função de Captura Blindada Sem Bugs
local function secureGrabEgg(prompt)
    if not prompt or not prompt.Parent then return false end
    local successGrab = false
    pcall(function()
        local oldDur = prompt.HoldDuration
        prompt.HoldDuration = 0
        for i = 1, 4 do
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(0.01)
                prompt:InputHoldEnd()
            end
            task.wait(0.03)
        end
        prompt.HoldDuration = oldDur
        successGrab = true
    end)
    return successGrab
end

